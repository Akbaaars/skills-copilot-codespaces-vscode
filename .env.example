LOGIN_URL=https://example.com/login
TARGET_URL=https://example.com/dashboard/data
SITE_USERNAME=your-username
SITE_PASSWORD=your-password

# Login selectors
USERNAME_SELECTOR=input[name="username"]
PASSWORD_SELECTOR=input[name="password"]
LOGIN_SUBMIT_SELECTOR=button[type="submit"]

# Success check (one is enough)
LOGIN_SUCCESS_SELECTOR=.dashboard
LOGIN_SUCCESS_URL_CONTAINS=/dashboard

# Data extraction
DATA_ITEM_SELECTOR=.data-row
ITEM_TEXT_SELECTOR=
PAGINATION_NEXT_SELECTOR=a.next
MAX_PAGES=1
REQUEST_DELAY_MS=1000
INFINITE_SCROLL=false
MAX_SCROLLS=5
SCROLL_DELAY_MS=1200

# Output: json | csv | both
OUTPUT_FORMAT=both
OUTPUT_BASENAME=output/scrape-data
RETRY_COUNT=3
TIMEOUT_MS=15000
SHOW_BROWSER=false
ENV_FILE=.env
